# ---- Server-only secrets (never commit real values) ----
# HMAC pepper for student-number hashing. Rotating it invalidates all identity hashes.
STUDENT_NO_PEPPER=change-me-to-a-long-random-string
# HMAC key for signed session cookies.
SESSION_SECRET=change-me-to-another-long-random-string
# Passcode for the minimal admin console (MVP demo only).
ADMIN_PASSCODE=change-me-admin-passcode

# ---- Demo data (local only; never commit real values) ----
# Required by `pnpm db:seed`. Set it in the shell or in an ignored .env.local.
DEMO_PASSWORD=change-me-demo-password
# Demo-only verification code; must match the code seeded in the database.
DEMO_VERIFICATION_CODE=change-me-demo-code

# ---- Optional: point the app at a real Postgres / Supabase database ----
# Leave empty to use the embedded PGlite database under .data/pgdata
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>

# ---- Optional: Supabase cloud wiring (only needed when DATABASE_URL is set) ----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Runtime tuning ----
# The demo verification code is configured above; production must use a DB-backed code.
